// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  lessons   Lesson[]
}

model Language {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  lessons     Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  content   String
  language  Language @relation(fields: [languageId], references: [id])
  languageId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId     String
}
